<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sm64tracker.controller.MainController">
    <content>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <VBox styleClass="title-bar">
                <Label text="Course Select" styleClass="page-title"/>
            </VBox>

            <Label text="Courses" styleClass="section-label"/>
            <FlowPane fx:id="courseGrid" prefWrapLength="1100" styleClass="course-grid" hgap="18" vgap="18"/>
        </VBox>
    </content>
</ScrollPane>
