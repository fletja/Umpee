<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" styleClass="detail-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sm64tracker.controller.StarDetailController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Button text="Back" onAction="#goBack" styleClass="subtle-button"/>

    <VBox spacing="4" styleClass="card-panel">
        <Label fx:id="starNameLabel" text="Star Name" styleClass="course-heading"/>
        <Label fx:id="courseNameLabel" text="Course" styleClass="summary-label"/>
        <Label fx:id="currentPbLabel" text="Current PB: --" styleClass="summary-value"/>
    </VBox>

    <VBox spacing="10" styleClass="card-panel">
        <Label text="Add a new PB" styleClass="section-label"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="timeInputField" promptText="e.g. 26.42 or 1:02.34" styleClass="input-field" HBox.hgrow="ALWAYS"/>
            <Button text="Submit PB" onAction="#submitTime" styleClass="subtle-button"/>
        </HBox>
        <Label fx:id="statusLabel" text="" styleClass="alert-label"/>
    </VBox>

    <VBox spacing="10" styleClass="card-panel">
        <Label text="PB Progression" styleClass="page-title"/>
        <VBox fx:id="historyContainer" spacing="6" styleClass="history-list"/>
    </VBox>

    <VBox spacing="10" styleClass="card-panel">
        <Label text="Summary" styleClass="section-label"/>
        <HBox spacing="20">
            <VBox>
                <Label text="First recorded PB" styleClass="summary-label"/>
                <Label fx:id="firstPbLabel" text="--" styleClass="summary-value"/>
            </VBox>
            <VBox>
                <Label text="Current PB" styleClass="summary-label"/>
                <Label fx:id="currentPbSummaryLabel" text="--" styleClass="summary-value"/>
            </VBox>
            <VBox>
                <Label text="Time improved" styleClass="summary-label"/>
                <Label fx:id="improvementLabel" text="--" styleClass="summary-value"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
